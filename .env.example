# PostgreSQL
POSTGRES_DB=neomarket
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_TEST_DB=neomarket_test

# App
# Docker: db:5432 | Локальная разработка: localhost:5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/neomarket
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/neomarket_test
SECRET_KEY=change-me-in-production
DEBUG=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
MODERATION_URL=http://moderation:8001
B2C_URL=http://b2c:8002
B2B_TO_MOD_KEY=change-me-in-production
B2C_TO_B2B_KEY=change-me-in-production
B2B_TO_B2C_KEY=change-me-in-production
